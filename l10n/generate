#!/usr/bin/env ruby
# Generates localized strings for every platform from l10n/Localizable.csv.
#
# CSV columns: key, comment, platforms, <lang>...
#   - rows whose key starts with "#" are section comments and produce nothing
#   - keys starting with "@" are InfoPlist keys (Apple only)
#   - platforms: "apple", "web", or "apple web"
#
# Outputs:
#   --swift FILE  Apple key enum (MyLocalizedKey)
#   --root DIR    Apple <lang>.lproj/Localizable.strings and InfoPlist.strings
#   --web DIR     web <lang>.json (keys nested on ".", placeholders as %{n})

require 'csv'
require 'json'
require 'fileutils'
require 'optparse'

module L10n
  PLATFORMS = %w[apple web].freeze
  STRINGS_FILE = "Localizable.strings".freeze
  PLIST_FILE = "InfoPlist.strings".freeze

  class Error < StandardError; end

  Entry = Struct.new(:key, :comment, :platforms, :values)

  # Parses the CSV into entries. Missing translations fall back to the first
  # language and are collected in `missing` as [key, lang] pairs.
  def self.parse(csv_text)
    rows = CSV.parse(csv_text)
    header = rows[0].map { |h| h.to_s.strip }
    unless header[0] == "key" && header[1] == "comment" && header[2] == "platforms" && header.length > 3
      raise Error, "Invalid CSV header #{header.inspect}; expected key, comment, platforms, <languages...>"
    end
    langs = header[3..-1]
    entries = []
    missing = []

    rows[1..-1].each do |row|
      key = row[0].to_s.strip
      next if key.empty? || key.start_with?("#")

      platforms = row[2].to_s.split
      if platforms.empty? || !(platforms - PLATFORMS).empty?
        raise Error, "Key \"#{key}\" has invalid platforms #{row[2].inspect}; use apple, web, or \"apple web\""
      end

      values = {}
      base = nil
      langs.each_with_index do |lang, i|
        value = row[3 + i].to_s.strip
        base = value if i.zero?
        if value.empty?
          missing << [key, lang]
          value = base
        end
        values[lang] = value
      end
      entries << Entry.new(key, row[1].to_s.strip, platforms, values)
    end

    [langs, entries, missing]
  end

  def self.for_platform(entries, platform)
    entries.select { |e| e.platforms.include?(platform) }
  end

  # --- Apple -----------------------------------------------------------------

  def self.apple_strings(entries, lang)
    content = []
    entries.each do |e|
      next if e.key.start_with?("@")
      content.push "/*#{e.comment}*/"
      content.push "\"#{e.key}\" = \"#{e.values[lang]}\";"
      content.push ""
    end
    content.join("\n")
  end

  def self.apple_plist_strings(entries, lang)
    content = []
    entries.each do |e|
      next unless e.key.start_with?("@")
      content.push "#{e.key.sub(/^@/, '')} = \"#{e.values[lang]}\";"
      content.push ""
    end
    content.join("\n")
  end

  def self.apple_swift(entries)
    content = ["/** Generated by l10n */", "", "public enum MyLocalizedKey: String {"]
    entries.each do |e|
      next if e.key.start_with?("@")
      content.push "  /**#{e.comment}*/"
      content.push "  case #{e.key.tr('.', '_')} = \"#{e.key}\""
    end
    content.push "}"
    content.join("\n")
  end

  # --- Web -------------------------------------------------------------------

  PLACEHOLDER = /%(?:(\d+)\$)?(?:@|lld|ld|d|f|s)|%%/

  # Converts Apple format placeholders to i18next "%{n}" interpolation.
  # Sequential placeholders are numbered from 0; "%n$@" maps to index n-1.
  def self.web_value(value)
    index = -1
    value.gsub(PLACEHOLDER) do |match|
      if match == "%%"
        "%"
      elsif $1
        "%{#{$1.to_i - 1}}"
      else
        index += 1
        "%{#{index}}"
      end
    end
  end

  def self.web_tree(entries, lang)
    tree = {}
    entries.each do |e|
      raise Error, "InfoPlist key \"#{e.key}\" cannot target web" if e.key.start_with?("@")
      parts = e.key.split(".")
      node = tree
      parts[0..-2].each_with_index do |part, i|
        node[part] = {} unless node.key?(part)
        unless node[part].is_a?(Hash)
          raise Error, "Key \"#{e.key}\" collides with key \"#{parts[0..i].join('.')}\""
        end
        node = node[part]
      end
      if node.key?(parts[-1])
        raise Error, "Key \"#{e.key}\" collides with an existing key or namespace"
      end
      node[parts[-1]] = web_value(e.values[lang])
    end
    sort_tree(tree)
  end

  def self.sort_tree(node)
    return node unless node.is_a?(Hash)
    node.keys.sort.each_with_object({}) { |k, h| h[k] = sort_tree(node[k]) }
  end

  def self.web_json(entries, lang)
    JSON.pretty_generate(web_tree(entries, lang)) + "\n"
  end

  # --- Writing ---------------------------------------------------------------

  def self.write_if_changed(path, content)
    return if File.exist?(path) && File.read(path) == content
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, content)
  end

  def self.run(csv_path, swift: nil, root: nil, web: nil, err: $stderr)
    langs, entries, missing = parse(File.read(csv_path))
    missing.each { |key, lang| err.puts "l10n: missing #{lang} translation for \"#{key}\"" }

    apple = for_platform(entries, "apple")
    webs = for_platform(entries, "web")

    if root
      langs.each do |lang|
        dir = File.join(root, "#{lang}.lproj")
        write_if_changed(File.join(dir, STRINGS_FILE), apple_strings(apple, lang))
        write_if_changed(File.join(dir, PLIST_FILE), apple_plist_strings(apple, lang))
      end
    end
    write_if_changed(swift, apple_swift(apple)) if swift
    if web
      langs.each { |lang| write_if_changed(File.join(web, "#{lang}.json"), web_json(webs, lang)) }
    end
    missing
  end
end

if $PROGRAM_NAME == __FILE__
  options = {}
  parser = OptionParser.new do |opts|
    opts.banner = "Usage: l10n/generate CSV_FILE [--swift FILE] [--root DIR] [--web DIR]"
    opts.on("--swift FILE", "Apple key enum output") { |v| options[:swift] = v }
    opts.on("--root DIR", "Apple .lproj output directory") { |v| options[:root] = v }
    opts.on("--web DIR", "web locale JSON output directory") { |v| options[:web] = v }
  end
  parser.parse!
  csv_file = ARGV.shift
  if csv_file.nil?
    warn parser.banner
    exit 1
  end
  begin
    L10n.run(csv_file, **options)
  rescue L10n::Error => e
    warn "l10n: #{e.message}"
    exit 1
  end
end
